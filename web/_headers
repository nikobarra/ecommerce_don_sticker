/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=15552000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https://*.googleusercontent.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Los videos se piden por tramos (Range): sin Accept-Ranges el navegador no puede saltar de un cuadro a otro.
/assets/*.mp4
  Accept-Ranges: bytes

# Solo los archivos con versión en el nombre (-hq-v2) se guardan «para siempre». REGLA: un video o imagen
# nuevo SIEMPRE lleva un nombre nuevo (-hq-v3...) y se agrega acá su ruta exacta; todo lo demás se revalida
# en cada visita (caché normal de Cloudflare), así un archivo reemplazado en el mismo nombre no queda viejo.
# Cloudflare admite UN solo comodín por regla, por eso las rutas van exactas.
/assets/escena-escritorio-hq-v2.mp4
  Cache-Control: public, max-age=31536000, immutable
/assets/escena-movil-hq-v2.mp4
  Cache-Control: public, max-age=31536000, immutable
/assets/escena-escritorio-inicio-hq-v2.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/escena-escritorio-final-hq-v2.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/escena-movil-inicio-hq-v2.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/escena-movil-final-hq-v2.webp
  Cache-Control: public, max-age=31536000, immutable

# Tipografías: 30 días. Si se cambia una, se cambia también su nombre.
/fonts/*
  Cache-Control: public, max-age=2592000

/admin.html
  X-Robots-Tag: noindex, nofollow

/cuenta.html
  X-Robots-Tag: noindex

/restablecer.html
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex

/verificar.html
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex

/pago.html
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
